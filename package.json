{
  "name": "@mjcctech/react-swipeable-list",
  "description": "Swipeable list component for React",
  "version": "1.1.2",
  "author": {
    "name": "Sandstream Development",
    "url": "https://github.com/sandstreamdev/react-swipeable-list/graphs/contributors"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mjcctech/react-swipeable-list"
  },
  "license": "MIT",
  "keywords": [
    "swipe",
    "swipeable",
    "list",
    "react",
    "component",
    "customizable",
    "mobile",
    "ios",
    "android",
    "touchscreen"
  ],
  "main": "dist/react-swipeable-list.cjs.js",
  "module": "dist/react-swipeable-list.esm.js",
  "browser": "dist/react-swipeable-list.umd.js",
  "peerDependencies": {
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/eslint-parser": "^7.27.1",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-modules-commonjs": "^7.23.3",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.27.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.0-beta.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.5.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.41.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-local-resolve": "^1.0.7",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "lint": "eslint --ext .js --max-warnings=0 --cache ./",
    "prepare": "npm run build && [ -n \"$CI\" ] || husky",
    "stylelint": "stylelint src/**/*.css examples/**/*.css --cache",
    "prettier": "prettier src/**/*.js examples/**/*.js --check",
    "test": "jest --no-cache"
  },
  "types": "dist/module.d.ts",
  "files": [
    "dist"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix",
      "jest --bail --findRelatedTests"
    ]
  }
}
